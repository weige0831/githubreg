{
  "manifest_version": 3,
  "name": "GitHub 自动注册",
  "version": "1.4.0",
  "description": "GitHub 自动注册：临时邮箱 + 自动填表 + 验证码自动输入，支持批量注册，token 自动导入管理器，侧边栏常驻面板（中文界面）",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub 自动注册",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "offscreen", "notifications", "sidePanel", "downloads", "browsingData"],
  "host_permissions": [
    "https://github.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
